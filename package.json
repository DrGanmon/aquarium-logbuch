{
  "name": "aquarium-logbuch",
  "version": "1.0.0",
  "description": "Mehrbenutzer-Webanwendung für Aquarien-Wasserwerte mit Graphen, Timern und Alarmen (SQLite)",
  "main": "server.js",
  "license": "CC-BY-NC-SA-4.0",
  "scripts": {
    "start": "node server.js",
    "build": "npm run typecheck && vite build --mode development",
    "dist": "npm run typecheck && vite build",
    "build:watch": "vite build --mode development --watch",
    "dist:watch": "vite build --watch",
    "test": "node scripts/test.js",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p public/tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.5.1",
    "express": "^5.3.0",
    "mongodb": "^7.7.0",
    "vue": "^3.5.43"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
