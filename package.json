{
  "name": "aquarium-logbuch",
  "version": "1.0.0",
  "description": "Mehrbenutzer-Webanwendung für Aquarien-Wasserwerte mit Graphen, Timern und Alarmen (SQLite)",
  "main": "server.js",
  "license": "CC-BY-NC-SA-4.0",
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/build.js",
    "dist": "node scripts/build.js --minify",
    "build:watch": "node scripts/build.js --watch",
    "dist:watch": "node scripts/build.js --minify --watch",
    "test": "node scripts/test.js",
    "dev": "vite",
    "typecheck": "node scripts/typecheck.js",
    "start:bun": "bun server.js",
    "test:bun": "bun scripts/test.js",
    "typecheck:bun": "bun scripts/typecheck.js",
    "build:bun": "bun scripts/build.js",
    "dist:bun": "bun scripts/build.js --minify",
    "build:watch:bun": "bun scripts/build.js --watch",
    "dist:watch:bun": "bun scripts/build.js --minify --watch",
    "dev:bun": "bun --bun node_modules/vite/bin/vite.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.5.1",
    "express": "^5.3.0",
    "mongodb": "^7.7.0",
    "vue": "^3.5.43"
  },
  "private": true,
  "engines": {
    "node": ">=22.12",
    "bun": ">=1.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13",
    "@vue/language-core": "3.3.13",
    "@volar/typescript": "2.4.28"
  },
  "trustedDependencies": []
}
