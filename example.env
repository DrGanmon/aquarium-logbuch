# ==============================================================================
# Aquarium-Logbuch – Umgebungskonfiguration (.env / example.env)
# ==============================================================================
# Kopiere diese Datei nach .env und passe die Werte an deine Umgebung an.

# ------------------------------------------------------------------------------
# 1. Server- & Netzwerk-Konfiguration
# ------------------------------------------------------------------------------
# Port, auf dem die Anwendung lauscht (Standard: 3000)
PORT=3000

# Öffentliche URL der Anwendung (z. B. https://aquarium.example.com oder http://localhost:3000)
# Wichtig für OIDC-Redirects und sichere Cookie-Attribute (bei https:// wird Secure automatisch aktiviert).
APP_URL=http://localhost:3000

# Auf "1" setzen, wenn die App hinter einem Reverse Proxy (z. B. Nginx, Traefik, Caddy) läuft.
# Dadurch wird die echte Client-IP für Rate-Limiting und Logs korrekt ausgewertet.
# TRUST_PROXY=1

# Optional: Cookie-Secure-Attribut manuell überschreiben ('true' oder 'false')
# COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 2. Datenbank-Konfiguration (SQLite / MongoDB)
# ------------------------------------------------------------------------------
# Typ der Datenbank: 'sqlite' (lokale dateibasierte DB) oder 'mongodb' (produktiv)
# Standard: 'sqlite' (wenn keine MONGODB_URI gesetzt ist)
DB_TYPE=mongodb

# Verbindungs-URI für MongoDB (nur relevant bei DB_TYPE=mongodb oder wenn gesetzt)
# Format: mongodb://[benutzer:passwort@]host:port/[datenbank][?optionen]
# Beispiel mit Docker Compose:
MONGODB_URI=mongodb://root:aquarium_secret_password@mongo:27017/aquarium?authSource=admin

# Optionaler Name der MongoDB-Datenbank (falls nicht bereits in der URI enthalten)
MONGODB_DB_NAME=aquarium

# Lokales Datenverzeichnis für Datei-Uploads (Bilder), Testsuiten und SQLite-Datenbank
DATA_DIR=/data

# ------------------------------------------------------------------------------
# 3. Administrator & Benutzer-Verwaltung & Rechtliches
# ------------------------------------------------------------------------------
# E-Mail-Adresse(n) des Administrators (für Admin-Bereich & Benutzerverwaltung)
# Mehrere Adressen können durch Komma getrennt angegeben werden (Groß-/Kleinschreibung wird ignoriert).
ADMIN_EMAIL=admin@example.com

# Optionale Kontakt- und Support-E-Mail-Adresse für das Impressum / Kontaktformular (Standard: ADMIN_EMAIL)
CONTACT_EMAIL=kontakt@example.com

# Optionale Impressums-E-Mail-Adresse nach § 5 DDG (Standard: CONTACT_EMAIL bzw. ADMIN_EMAIL)
IMPRINT_EMAIL=impressum@example.com

# Registrierung neuer Benutzer erlauben ('true' oder 'false')
# Auf 'false' setzen, um Neuregistrierungen zu sperren.
ALLOW_REGISTRATION=true

# Lokale Anmeldung mit Benutzername/Passwort erlauben ('true' oder 'false')
# Standard: 'true' (ohne OIDC) bzw. 'false' (sobald OIDC aktiviert ist, kann aber mit 'true' zugeschaltet werden)
LOCAL_LOGIN=true

# ------------------------------------------------------------------------------
# 4. OpenID Connect / Pocket ID (Optional)
# ------------------------------------------------------------------------------
# Issuer-URL deines OIDC-Providers (z. B. Pocket ID, Authentik, Keycloak)
# OIDC_ISSUER=https://id.example.com

# Client-ID aus der OIDC-Provider-Konfiguration
# OIDC_CLIENT_ID=aquarium-app-client-id

# Client-Secret (falls beim OIDC-Client ein Secret konfiguriert wurde, bei Public Clients optional)
# OIDC_CLIENT_SECRET=dein_client_secret

# Angeforderte OIDC-Scopes (Standard: openid profile email)
# OIDC_SCOPES=openid profile email

# Angezeigter Name auf dem Login-Button (z. B. 'Pocket ID' oder 'Mein SSO')
# OIDC_PROVIDER_NAME=Pocket ID

# Bestehende lokale Konten beim ersten OIDC-Login automatisch anhand des Benutzernamens verknüpfen ('true'/'false')
# OIDC_LINK_BY_USERNAME=false

# ------------------------------------------------------------------------------
# 5. Logging & Überwachungsprozess (Watchdog / Supervisor)
# ------------------------------------------------------------------------------
# Pfad zur Fehler- und System-Logdatei (Standard: data/aquarium.log)
LOG_FILE=/data/aquarium.log

# Überwachungsprozess (Supervisor) aktivieren ('true' oder 'false', Standard: true)
# Startet den Worker nach unerwarteten Fehlern oder Abstürzen automatisch neu.
SUPERVISOR=true

# ------------------------------------------------------------------------------
# 6. E-Mail- & SMTP-Server-Konfiguration (Passwort-Reset & Verifizierung)
# ------------------------------------------------------------------------------
# SMTP-Server-Host für den E-Mail-Versand (kann auch über die Admin-Oberfläche konfiguriert werden)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=aquarium-mailer
# SMTP_PASS=dein_smtp_passwort
# SMTP_FROM="Aquarium-Logbuch" <noreply@example.com>
# Mindestverzögerung zwischen E-Mails in Millisekunden (Rate-Limiting / Throttling in der Mail-Queue)
# SMTP_RATE_LIMIT_MS=500

# ------------------------------------------------------------------------------
# 7. Multithreading & Nebenläufigkeit (Multi-Core / Worker-Threads)
# ------------------------------------------------------------------------------
# Anzahl der parallelen Anwendungsprozesse (Workers): Zahl (z. B. 2, 4) oder 'auto' (alle CPU-Kerne)
# Ermöglicht das gleichzeitige Bedienen vieler Benutzer über alle verfügbaren Prozessorkerne hinweg.
WORKERS=auto

# Anzahl der Worker Threads für rechenintensive Hintergrund- und Krypto-Aufgaben (Scrypt, Datenanalyse)
# Standard: 'auto' oder bis zu 4 Threads
WORKER_THREADS=auto

# ------------------------------------------------------------------------------
# 8. OpenAI / ChatGPT KI-Assistent (Optional)
# ------------------------------------------------------------------------------
# Optionaler globaler Server-API-Schlüssel für OpenAI / ChatGPT.
# Wenn nicht gesetzt, können Benutzer ihren eigenen persönlichen API-Key im Profil hinterlegen (Bring Your Own Key).
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
