<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{title}}</title></head>
<body style="margin:0;background:#f0fdfa;font-family:Arial,sans-serif;color:#1e293b;line-height:1.6">
<div style="max-width:600px;margin:24px auto;padding:24px;background:#fff;border-radius:12px">
<img src="{{logoUrl}}" alt="Aquarium-Logbuch" width="48" height="48">
<h1 style="font-size:22px">{{headline}}</h1>
<p>{{intro}}</p><p>{{numbersText}}</p>
<p style="padding:16px;background:#fef3c7;border-radius:8px">{{refillText}}</p>
<p><a href="{{ctaUrl}}" style="display:inline-block;background:#12343b;color:#fff;padding:12px 20px;border-radius:8px;text-decoration:none">{{ctaText}}</a></p>
<p style="color:#64748b">{{hint}}</p>
<hr><p style="color:#64748b;font-size:12px">{{footerNote}}</p>
</div></body></html>
